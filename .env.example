# Copy this file to .env and fill in real values. .env is git-ignored.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENABLED=true
PAYPAL_DEMO_BUYER_EMAIL=sb-xxxx@personal.example.com
# Developer Dashboard -> your app -> Webhooks -> Webhook ID. Webhooks are rejected until this is set.
PAYPAL_WEBHOOK_ID=

# Where the React app runs (used in Fix & Pay links inside PayPal reminders)
CASHFLOW_APP_BASE_URL=http://localhost:5173
# Reset / time-travel / simulated-payment endpoints and access keys on /api/demo. Set false outside demos.
CASHFLOW_DEMO_ENABLED=true

# Optional: leave empty to use the scripted agent (no AI calls)
# Groq key: console.groq.com -> API Keys. Set CASHFLOW_LLM_PROVIDER=anthropic (and base URL/model) to use Claude instead.
CASHFLOW_LLM_API_KEY=
CASHFLOW_LLM_PROVIDER=groq
CASHFLOW_LLM_BASE_URL=https://api.groq.com/openai/v1
CASHFLOW_LLM_MODEL=openai/gpt-oss-120b
